diff --git a/policy/ACT/tests/test_action_alignment.py b/policy/ACT/tests/test_action_alignment.py
new file mode 100644
index 00000000..d96dcb43
--- /dev/null
+++ b/policy/ACT/tests/test_action_alignment.py
@@ -0,0 +1,44 @@
+"""Protect the observation/target boundary; legacy unmarked inputs stay unchanged."""
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import h5py
+import numpy as np
+
+spec = importlib.util.spec_from_file_location("act_dataset_utils", Path(__file__).parents[1] / "utils.py")
+utils = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(utils)
+
+
+class ActionAlignmentTest(unittest.TestCase):
+    def check_sample(self, marked):
+        with tempfile.TemporaryDirectory() as directory:
+            rows = np.arange(6 * 14, dtype=np.float32).reshape(6, 14)
+            with h5py.File(Path(directory) / "episode_0.hdf5", "w") as file:
+                if marked:
+                    file.attrs["action_alignment"] = "state_t_to_next_target"
+                file.create_dataset("action", data=rows + 100)
+                file.create_dataset("observations/qpos", data=rows)
+                file.create_dataset("observations/images/cam_head", data=np.zeros((6, 8, 8, 3), dtype=np.uint8))
+            stats = {"action_mean": np.zeros(14), "action_std": np.ones(14),
+                     "qpos_mean": np.zeros(14), "qpos_std": np.ones(14)}
+            with patch("numpy.random.choice", return_value=2):
+                dataset = utils.EpisodicDataset([0], directory, ["cam_head"], stats, 6)
+                _, qpos, actions, padding = dataset[0]
+            np.testing.assert_array_equal(qpos.numpy(), rows[2])
+            np.testing.assert_array_equal(actions[0].numpy(), rows[2 if marked else 1] + 100)
+            self.assertEqual(int((~padding).sum()), 4 if marked else 5)
+            self.assertIs(dataset.is_sim, True if marked else None)
+
+    def test_marked_native_targets_match_observation_index(self):
+        self.check_sample(True)
+
+    def test_unmarked_legacy_offset_and_none_flag_are_preserved(self):
+        self.check_sample(False)
+
+
+if __name__ == "__main__":
+    unittest.main()
